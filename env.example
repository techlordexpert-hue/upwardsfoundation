SECRET=put-a-long-random-string-here
# Storage is added from Vercel > Storage > Upstash Redis (sets KV_REST_API_URL / KV_REST_API_TOKEN automatically)
BMS_API_KEY=your-bms-key
BMS_API_URL=https://the-send-sms-endpoint-from-your-BMS-docs
BMS_SENDER_ID=Upwards
# Optional: match the request format in your BMS docs. Placeholders: {key} {sender} {message} {to} (array) {to_csv}
# BMS_BODY={"key":"{key}","sender":"{sender}","recipient":"{to}","message":"{message}"}
# BMS_HEADERS={"Authorization":"Bearer {key}"}
